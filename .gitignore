# 맥이 폴더마다 자동으로 만드는 설정 파일
.DS_Store
.AppleDouble
.LSOverride
._*

# 윈도우가 자동으로 만드는 파일
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# 편집기 개인 설정 (기기마다 달라서 공유하지 않습니다)
.vscode/
.idea/
*.swp
*~

# 로그와 임시 파일
*.log
.cache/
tmp/

# 워드·한글이 문서를 열어 둔 동안 만드는 잠금 파일
# (여는 사람 이름이 들어 있고, 저장소에 들어가면 그대로 배포됩니다)
~$*

# 문서를 고치기 전에 떠 두는 백업
# (.md가 아니라서 넷리파이의 배포 제외 규칙에 걸리지 않습니다 —
#  저장소에 들어가면 주소를 아는 사람이 그대로 내려받습니다)
*.bak

# 혹시 도구를 쓰게 될 경우 대비
node_modules/
dist/
.netlify/
